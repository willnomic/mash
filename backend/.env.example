# Dono do banco — usado só pelo Prisma CLI (migrate). Nunca pela aplicação.
DATABASE_URL="postgresql://mash_owner:mash_owner_dev_only@127.0.0.1:5433/mash"

# Aplicação — sem posse de tabela, para que FORCE ROW LEVEL SECURITY se
# aplique (docs/d012-multi-tenant-rls.md).
DATABASE_URL_APP="postgresql://mash_app:mash_app_dev_only@127.0.0.1:5433/mash"

# Segredo de assinatura do JWT. Valor de desenvolvimento só — em produção
# vem da plataforma gerenciada (D-005), nunca do código (5.6).
JWT_SECRET="dev_only_jwt_secret_troque_em_producao"

# D-041: TaxRateService.findRate() recusa devolver alíquota placeholder
# (TaxRate.isPlaceholder — hoje, as 27 linhas de ICMS semeadas a 18%
# uniforme) sempre que NODE_ENV não for "development" nem "test" —
# inclusive vazia/ausente (falha fechada, D-012 mesmo espírito). O risco
# real é o oposto de "esquecer": a plataforma gerenciada (D-005) NUNCA
# deve ter NODE_ENV=development — se tiver, por engano de deploy ou
# variável copiada deste arquivo, a recusa para de disparar em produção.
NODE_ENV="development"
