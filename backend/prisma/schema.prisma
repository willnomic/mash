generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Raiz do isolamento multi-tenant (D-012). Não carrega tenantId — o próprio
// id é o tenant. A política de RLS compara "id" com o tenant da sessão, para
// que uma requisição só enxergue a própria linha desta tabela.
model Tenant {
  id        String   @id @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
