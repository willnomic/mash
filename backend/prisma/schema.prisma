generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Regime de renda do tenant (D-043, consulta tributária) — fixo por lei,
// não enum que o tenant customiza (D-020, mesmo critério de
// AnttCategory): determina o CST de ICMS do documento fiscal (00 normal
// pra Presumido/Real, 90 pra Simples — não existe CSOSN no CT-e) e se
// IBS/CBS são obrigatórios (Presumido/Real) ou facultativos em 2026
// (Simples/MEI). Nada consome este campo em cálculo ainda — assento
// reservado, nenhum fluxo construído (D-043 não pediu isso).
enum IncomeTaxRegime {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
}

// Raiz do isolamento multi-tenant (D-012). Não carrega tenantId — o próprio
// id é o tenant. A política de RLS compara "id" com o tenant da sessão, para
// que uma requisição só enxergue a própria linha desta tabela.
model Tenant {
  id                   String                @id @db.Uuid
  name                 String
  // Identifica o tenant no login, antes de existir tenant na sessão
  // (D-029) — não é a chave primária (D-015: UUID nunca aparece pro
  // operador). Formato (minúsculo, sem espaço) é reforçado por CHECK no
  // banco, não só validado na aplicação.
  slug                 String                @unique @db.VarChar(63)
  // Regime tributário (D-043) — todos nullable: nenhum tenant hoje tem
  // isso configurado (não existe tela/fluxo de onboarding fiscal ainda),
  // e "não configurado" é um estado honesto, diferente de assumir um
  // regime por default.
  incomeTaxRegime      IncomeTaxRegime?
  // Só tem sentido quando incomeTaxRegime = SIMPLES_NACIONAL — indicador
  // de contribuinte do Simples, campo à parte do CST (consulta
  // tributária: "CST 90 para Simples Nacional, COM indicador de
  // contribuinte do Simples à parte"). Nada no banco amarra isso a
  // incomeTaxRegime — não pedido, e um CHECK cruzando os dois campos
  // sem uso real ainda seria estrutura especulativa (CLAUDE.md seção 2).
  isSimplesIcmsContributor Boolean?
  // Reservado pro "Simples Híbrido" (LC 214/2025, a partir de 2027) —
  // regime de APURAÇÃO de IBS/CBS, deliberadamente separado de
  // incomeTaxRegime (regime de RENDA): a empresa pode ser Simples
  // Nacional pra renda e ainda assim apurar IBS/CBS fora do DAS. Texto
  // livre, não enum: só conheço um valor possível hoje ("Simples
  // Híbrido") e fechar um enum de um valor só arriscaria nascer
  // incompleto quando os outros regimes de apuração aparecerem — abrir
  // enum depois é migração simples, é o "assento reservado" que a
  // consulta pediu, não o fluxo.
  ibsCbsApurationRegime String?
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  users                User[]
  branches             Branch[]
  parties              Party[]
  addresses            Address[]
  drivers              Driver[]
  vehicles             Vehicle[]
  lanes                Lane[]
  freightRates         FreightRate[]
  quoteStatuses        QuoteStatus[]
  quotes               Quote[]
  quoteCostTypes       QuoteCostType[]
  quoteCostLines       QuoteCostLine[]
  orderStatuses        OrderStatus[]
  orders               Order[]
  documentCounters     DocumentCounter[]
  tripStatuses         TripStatus[]
  trips                Trip[]
  riskClearances       RiskClearance[]
  deductionReasons     DeductionReason[]
  carrierHires         CarrierHire[]
  carrierPayments      CarrierPayment[]
  tollVoucherPurchases TollVoucherPurchase[]
  occurrenceTypes      OccurrenceType[]
  occurrences          Occurrence[]
  carrierProfiles      CarrierProfile[]
  dayPeriods           DayPeriod[]
  pickupOrders         PickupOrder[]
  pickupOrderItems     PickupOrderItem[]
  invoices             Invoice[]
  boletos              Boleto[]
  receivableEvents     ReceivableEvent[]
  attachments          Attachment[]
  ibsCbsTaxSituations  IbsCbsTaxSituation[]
}

// Filial é CNPJ, não organograma (D-011). Cadastro (Party, Driver,
// Vehicle...) não carrega branchId; movimento (Order, Trip, CTe, Invoice...)
// carrega. Existe agora só pra esses modelos já nascerem com branchId —
// zero tela, zero filtro, zero permissão por filial no MVP.
model Branch {
  id               String            @id @db.Uuid
  tenantId         String            @db.Uuid
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  name             String
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  orders           Order[]
  trips            Trip[]
  carrierHires     CarrierHire[]
  occurrences      Occurrence[]
  pickupOrders     PickupOrder[]
  documentCounters DocumentCounter[]
  invoices         Invoice[]

  @@index([tenantId])
}

// Papel define o que se pode fazer (D-009) — lógica separada de tenant, que
// define quais dados existem (D-012). Nunca misturar as duas numa consulta.
// Valores em inglês (D-007): são cargos genéricos, sem significado legal ou
// setorial brasileiro, então não são exceção à regra do inglês.
enum UserRole {
  OPERATOR
  MANAGER
  FINANCE
  ADMIN
}

model User {
  id           String   @id @db.Uuid
  tenantId     String   @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String
  passwordHash String
  name         String
  role         UserRole
  // Cadastro nunca tem hard delete (D-017): inativar é estado, não remoção.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  // Anexos que este usuário enviou (D-042) — "quem enviou" do metadado.
  uploadedAttachments Attachment[]

  @@unique([tenantId, email])
  @@index([tenantId, active])
}

// Individual/Company em inglês (D-007): "pessoa física/jurídica" não é
// termo jurídico intraduzível como Tomador — o significado sobrevive à
// tradução. Já CPF/CNPJ/IE ficam como o setor escreve, sem tradução.
enum PersonType {
  INDIVIDUAL
  COMPANY
}

// Uma parte, não um papel (D-018, renomeado de Customer para Party — D-032:
// a mesma parte pode ser cliente e terceiro contratado, "Customer" passou a
// mentir). Não existem entidades separadas para remetente, destinatário e
// tomador — a mesma Party pode ser os três na mesma carga, e a mesma Party
// pode ainda ser o terceiro contratado numa viagem diferente (CarrierHire).
// Papel é relacionamento de quem referencia (Order, CarrierHire), nunca
// campo aqui. Cadastro é da empresa: sem branchId (D-011). Tela continua
// dizendo "Clientes" e "Transportadores" (D-008) — o nome do model é
// vocabulário de código, não de tela.
model Party {
  id                       String          @id @db.Uuid
  tenantId                 String          @db.Uuid
  tenant                   Tenant          @relation(fields: [tenantId], references: [id])
  personType               PersonType
  name                     String
  // Exatamente um dos dois preenchido, reforçado por CHECK no banco — não
  // confiar só na aplicação lembrar (mesmo critério de D-012/D-014/D-029).
  // Dígito verificador NÃO é validado aqui: é lógica não trivial, e regra
  // fiscal não se responde de memória (seção 1.6) — só formato (contagem
  // de dígitos) é garantido no banco. Unicidade por documento dentro do
  // tenant vem dos dois @@unique abaixo.
  cpf                      String?         @db.VarChar(11)
  cnpj                     String?         @db.VarChar(14)
  // Inscrição estadual: texto livre, sem formato validado — varia por UF e
  // inclui "ISENTO". Não modelar regra de obrigatoriedade sem fonte.
  ie                       String?
  // Preferência de faturamento (D-042) — texto livre, opcional. Evidência
  // de campo: "o agrupamento de CT-e é definido pelo cliente, cada um
  // exige um formato de envio" — não sustenta uma taxonomia de ciclo
  // (semanal/mensal/etc), só um campo onde anotar a preferência. Não
  // inventar estrutura que a evidência não pede (seção 1.6/CLAUDE.md 2).
  invoicingPreference      String?
  // Cadastro nunca tem hard delete (D-017): inativar é estado, não remoção.
  active                   Boolean         @default(true)
  createdAt                DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime        @updatedAt @db.Timestamptz(3)
  addresses                Address[]
  freightRates             FreightRate[]
  // Três relações nomeadas para o mesmo model — uma Party pode ser
  // sender numa Order e tomador em outra (D-018).
  ordersAsSender           Order[]         @relation("OrderSender")
  ordersAsRecipient        Order[]         @relation("OrderRecipient")
  ordersAsTomador          Order[]         @relation("OrderTomador")
  // Terceiro é uma parte que exerce papel (D-018 aplicado a D-019), não
  // cadastro próprio — reaproveita Party (já cobre PF/CPF e PJ/CNPJ,
  // exatamente TAC/ETC), papel vive em CarrierHire, não aqui.
  carrierHiresAsThirdParty CarrierHire[]   @relation("CarrierHireThirdParty")
  // Existência opcional (D-032): é o que torna a Party um transportador
  // contratável, não um campo a mais no cadastro do cliente.
  carrierProfile           CarrierProfile?
  // Veículos de que esta Party é proprietária (D-023) — ownerPartyId nulo
  // no Vehicle significa frota própria, então essa lista só existe para
  // Party que é proprietária de terceiro.
  ownedVehicles            Vehicle[]       @relation("VehicleOwner")
  // Faturas em que esta Party é o tomador cobrado (D-042).
  invoices                 Invoice[]

  @@unique([tenantId, cpf])
  @@unique([tenantId, cnpj])
  @@index([tenantId, active])
}

// Entidade própria — uma Party pode ter várias (D-018). Campos em
// português (logradouro, número, bairro, município, UF, CEP): são os
// nomes do próprio schema de NF-e/CT-e, que D-024 vai precisar mapear —
// mesmo critério de exceção do D-007 que manteve Tomador/Embarcador.
// Carrega tenantId e RLS próprios: não basta herdar do Party via join,
// senão uma consulta crua nesta tabela vazaria entre tenants (D-012).
model Address {
  id                 String        @id @db.Uuid
  tenantId           String        @db.Uuid
  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  partyId            String        @db.Uuid
  party              Party         @relation(fields: [partyId], references: [id])
  logradouro         String
  numero             String?
  complemento        String?
  bairro             String
  municipio          String
  uf                 String        @db.Char(2)
  cep                String        @db.VarChar(8)
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)
  tripsAsDestination Trip[]
  pickupOrders       PickupOrder[]

  @@index([tenantId, partyId])
}

// Vínculo do motorista com a transportadora (D-019, assento reservado — a
// contratação de terceiro em si, TAC/ETC, ainda não existe como cadastro
// próprio). Inglês (D-007): não é termo jurídico, "funcionário/autônomo"
// não perde precisão traduzido.
enum EmploymentType {
  EMPLOYEE
  SELF_EMPLOYED
}

// Motorista é cadastro, não conta de acesso (D-009) — sem senha, sem
// login, sem relação com User. Sem branchId: cadastro é da empresa
// (D-011).
model Driver {
  id             String          @id @db.Uuid
  tenantId       String          @db.Uuid
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  name           String
  // Formato básico (contagem de dígitos) no banco, igual Party — não o
  // dígito verificador (seção 1.6).
  cpf            String          @db.VarChar(11)
  // Número e categoria da CNH ficam texto livre, sem CHECK de formato:
  // diferente de CPF/CEP, não tenho como confirmar a regra de memória com
  // segurança (seção 1.6) — validação fica para quando houver fonte.
  cnhNumber      String
  cnhCategory    String
  // Data de calendário, não timestamp (D-016) — vencimento não tem hora.
  cnhValidUntil  DateTime        @db.Date
  employmentType EmploymentType
  // Cadastro nunca tem hard delete (D-017): inativar é estado, não remoção.
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  trips          Trip[]
  riskClearances RiskClearance[]

  @@unique([tenantId, cpf])
  @@unique([tenantId, cnhNumber])
  @@index([tenantId, active])
}

// Tipo fixo por regulação do setor (ANTT), não varia por cliente — D-020
// já cita "tipo de veículo" como exceção que permanece enum, não tabela.
// Nomes em português: classificação do próprio setor de transporte
// rodoviário, sem equivalente direto em inglês (mesmo critério de
// Tomador/Embarcador em D-007).
enum VehicleType {
  CAVALO_MECANICO
  CARRETA
  TRUCK
  TOCO
}

// Vehicle é a unidade individual — cavalo mecânico e carreta são cadastros
// separados, cada um com placa e RENAVAM próprios (D-018). A composição
// (qual cavalo puxa qual carreta numa viagem) pertence à viagem, não ao
// cadastro — por isso não existe nenhuma referência de um Vehicle a outro
// aqui. Sem branchId: cadastro é da empresa (D-011).
//
// Propriedade (D-023, seção 3.2): ownerPartyId nulo = frota própria do
// tenant; preenchido = de terceiro, com o proprietário nominal que a
// ficha de liberação de risco exige (RiskClearance.ownerName hoje é só
// texto livre, sem vínculo a nenhum cadastro — este campo é o que torna
// o proprietário identificável). Substitui o enum VehicleOwnership que
// existia antes: um enum paralelo a este campo poderia divergir dele
// (ownership='OWNED' com ownerPartyId preenchido, por exemplo) — fonte
// única de verdade (CLAUDE.md 3.2), a propriedade é derivada só da FK.
model Vehicle {
  id              String          @id @db.Uuid
  tenantId        String          @db.Uuid
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  plate           String
  // Texto livre, sem CHECK: RENAVAM já teve tamanho histórico diferente do
  // atual, e placa tem dois formatos válidos (antigo e Mercosul) — não é
  // regra estável o bastante pra afirmar de memória (seção 1.6).
  renavam         String
  type            VehicleType
  ownerPartyId    String?         @db.Uuid
  ownerParty      Party?          @relation("VehicleOwner", fields: [ownerPartyId], references: [id])
  // Decimal, não number — mesmo cuidado do D-013 para valor que alimenta
  // cálculo de frete depois (R$/ton).
  capacityKg      Decimal         @db.Decimal(10, 3)
  tareKg          Decimal         @db.Decimal(10, 3)
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  // Três relações nomeadas: o mesmo Vehicle pode ser o veículo principal
  // numa Trip e carreta em outra — a composição é da viagem (D-018).
  tripsAsVehicle  Trip[]          @relation("TripVehicle")
  tripsAsTrailer1 Trip[]          @relation("TripTrailer1")
  tripsAsTrailer2 Trip[]          @relation("TripTrailer2")
  riskClearances  RiskClearance[]

  @@unique([tenantId, plate])
  @@unique([tenantId, renavam])
  @@index([tenantId, active])
  @@index([tenantId, ownerPartyId])
}

// Trecho origem-destino para precificação — independente de Party ou
// Address (D-018 lista Lane como cadastro próprio, não sub-entidade).
// Inglês (D-007): city/state são conceitos geográficos genéricos, sem
// vocabulário fiscal a preservar — diferente de Address, que precisa
// bater com o schema de NF-e/CT-e. Sem branchId: cadastro é da empresa
// (D-011).
model Lane {
  id               String        @id @db.Uuid
  tenantId         String        @db.Uuid
  tenant           Tenant        @relation(fields: [tenantId], references: [id])
  originCity       String
  originState      String        @db.Char(2)
  destinationCity  String
  destinationState String        @db.Char(2)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)
  freightRates     FreightRate[]

  @@unique([tenantId, originCity, originState, destinationCity, destinationState])
  @@index([tenantId])
}

// Tabela de preço com vigência (D-014). Sem branchId: tabela de preço é da
// empresa (D-011).
//
// Imutabilidade garantida no banco, não por disciplina: o role de
// aplicação só tem UPDATE liberado em validTo e updatedAt (GRANT por
// coluna, na migração) — tarifa, valor, e a identidade da linha
// (tenantId/partyId/laneId/validFrom) nunca podem ser alteradas depois
// de criadas. "Fechar a linha vigente" é o único UPDATE possível.
//
// Sobreposição de vigência para o mesmo tenant+party+lane é bloqueada
// por EXCLUDE USING gist na migração (btree_gist) — não por validação na
// aplicação.
model FreightRate {
  id                   String   @id @db.Uuid
  tenantId             String   @db.Uuid
  tenant               Tenant   @relation(fields: [tenantId], references: [id])
  partyId              String   @db.Uuid
  party                Party    @relation(fields: [partyId], references: [id])
  laneId               String   @db.Uuid
  lane                 Lane     @relation(fields: [laneId], references: [id])
  // Data de calendário, não timestamp (D-016) — vigência não tem hora.
  validFrom            DateTime @db.Date
  validTo              DateTime @db.Date
  // Escalas de D-013. Decimal sempre — nunca number: a+b concatena string
  // em vez de somar (testado abaixo).
  rate                 Decimal  @db.Decimal(18, 6)
  minimumFreight       Decimal  @db.Decimal(14, 2)
  additionalPercentage Decimal  @db.Decimal(7, 4)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)
  quotes               Quote[]
  orders               Order[]

  @@index([tenantId, partyId, laneId])
}

// Lista de domínio em tabela, não enum (D-020): tenantId nulo = padrão do
// sistema (aberta/fechada/perdida, semeadas na migração), preenchido =
// status próprio daquele tenant. Política de RLS não é a padrão: leitura
// e escrita liberam tenantId IS NULL OU do próprio tenant — um tenant
// consegue, em teoria, criar uma linha "global" (tenantId NULL). Aceito
// deliberadamente: é só um catálogo de status, não dado isolado de outro
// tenant — diferente de User/Party/etc., onde isso seria grave.
// Ciclo de vida (unidade "desfecho, validade e revisão"): OPEN (aberta,
// ainda sem preço final) → CLOSED (preço fechado, nos dois caminhos de
// precificação) → desfecho do cliente, ACCEPTED ("Aceita") ou REJECTED
// ("Recusada", reaproveitado da linha antes chamada LOST/"Perdida" —
// renomeada em 20260910020000_rename_quote_status_lost_to_rejected: o
// caso "cliente sumiu" não é este status, é derivado (linha abaixo), e
// com ele fora "Recusada" descreve melhor o que sobrou — não existe
// status separado pra recusa, ver QuoteService.reject()). EXPIRADA NÃO
// É STATUS: é derivada (CLOSED, sem desfecho, validUntil já passado) —
// materializar exigiria job periódico, que cria janela de mentira
// quando não roda; separar recusa de expiração é o que permite
// responder "perdi por preço ou por falta de follow-up?".
model QuoteStatus {
  id        String   @id @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  // Identificador estável usado pelo código (ex.: "OPEN") — nunca muda,
  // diferente de name (rótulo em português pra tela, D-008).
  code      String
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  quotes    Quote[]

  @@unique([tenantId, code])
}

// Etapa opcional que antecede o pedido (D-018, D-028). Sem branchId: não
// listada como movimento no D-018 (cadastro é da empresa, D-011) — é
// registro de precificação, não de operação.
//
// Dois caminhos mutuamente exclusivos (D-041), mesma tabela — "o fluxo
// diverge, o modelo não" (D-018):
//
// 1. TABELA (o que já existia): freightRateId preenchido, valores
//    copiados da FreightRate no INSERT — imutável desde a criação.
// 2. CUSTO (D-041, validação de campo: dor nº 1 do operador é "cálculo de
//    tudo, margem, imposto"): freightRateId nulo, marginPercentage e
//    icmsUf informados na criação, linhas de custo em QuoteCostLine.
//    total/icmsRateApplied/ibsRateApplied/cbsRateApplied só existem
//    depois do fechamento — QuoteService.close() soma as linhas, lê
//    TaxRate vigente na data do fechamento, recompõe o imposto POR
//    DENTRO e aplica a margem, também por dentro (ver QuotePricingCalculator).
//
// CHECK na migração garante que os dois caminhos nunca se misturam numa
// mesma linha: campos do caminho 1 preenchidos ⟺ campos do caminho 2
// nulos, e vice-versa. total (preço final) é o único campo comum aos
// dois — para TABELA é conhecido no INSERT; para CUSTO só existe depois
// do fechamento.
//
// Imutabilidade garantida no banco (D-014): mash_app só tem UPDATE
// liberado em statusId, icmsRateApplied, ibsRateApplied, cbsRateApplied,
// total, validUntil e updatedAt (GRANT por coluna) — freightRateId/rate/
// minimumFreight/additionalPercentage/marginPercentage/icmsUf/
// previousQuoteId nunca mudam depois de criados, nos dois caminhos.
// DELETE revogado (D-017: é histórico — "perdida" é estado, não
// remoção).
model Quote {
  id                   String        @id @db.Uuid
  tenantId             String        @db.Uuid
  tenant               Tenant        @relation(fields: [tenantId], references: [id])
  // Referência de auditoria à linha de origem (D-014) — não redundante
  // com party/lane: ambos são derived via freightRate. Nulo no caminho
  // por custo (D-041) — não existe FreightRate nesse caminho.
  freightRateId        String?       @db.Uuid
  freightRate          FreightRate?  @relation(fields: [freightRateId], references: [id])
  statusId             String        @db.Uuid
  status               QuoteStatus   @relation(fields: [statusId], references: [id])
  // Congelado no fechamento (caminho TABELA) — cópia, não consulta.
  // Escalas de D-013. Nulo no caminho CUSTO.
  rate                 Decimal?      @db.Decimal(18, 6)
  minimumFreight       Decimal?      @db.Decimal(14, 2)
  additionalPercentage Decimal?      @db.Decimal(7, 4)
  // Margem pedida pelo operador (D-041) — ENTRADA do cálculo, não saída.
  // Só existe no caminho CUSTO, informada na criação, nunca muda depois
  // (recalcular com margem diferente é cotação nova, não edição).
  marginPercentage     Decimal?      @db.Decimal(7, 4)
  // UF de referência do ICMS (D-041) — só existe no caminho CUSTO. Sem
  // Party/Lane nesta tabela pra derivar UF de outro jeito; obrigatório
  // pra escolher a linha certa de TaxRate.
  icmsUf               String?       @db.Char(2)
  // Alíquotas efetivamente usadas no fechamento (D-041/D-014) — snapshot,
  // não referência: se a lei mudar depois, uma cotação já fechada não
  // muda de valor. Nulas até o fechamento no caminho CUSTO; nunca
  // preenchidas no caminho TABELA (ele não usa TaxRate).
  icmsRateApplied      Decimal?      @db.Decimal(7, 4)
  ibsRateApplied       Decimal?      @db.Decimal(7, 4)
  cbsRateApplied       Decimal?      @db.Decimal(7, 4)
  // Preço final. Caminho TABELA: conhecido no INSERT (cálculo de frete
  // real ainda não existe, quem chama informa). Caminho CUSTO: só existe
  // depois do fechamento — soma dos custos + recomposição de imposto +
  // margem (D-041).
  total                Decimal?      @db.Decimal(14, 2)
  // Validade da proposta ("válida até dia 15") — DATE, não timestamptz:
  // EXCEÇÃO À D-016, mesmo critério e mesmo tratamento da D-045 (hora de
  // PickupOrder). Data de calendário acordada com o cliente, não
  // instante — guardar como timestamptz reabriria a confusão de fuso que
  // a D-016 existe pra evitar, por um instante que ninguém combinou.
  // Anulável: cotação sem prazo combinado nunca expira (a expiração é
  // derivada, ver QuoteStatus acima). Congelada no fechamento
  // (QuoteService.close()), mesmo mecanismo de GRANT de coluna das
  // alíquotas — calculada por computeQuoteValidUntil (@mash/shared) a
  // partir de um prazo em dias ou meses informado por quem fecha.
  validUntil           DateTime?     @db.Date
  // Revisão (desconto na mesma negociação) ou recotação (negociação
  // nova, carga podendo ser a mesma) — um campo só cobre os dois casos,
  // a distinção é DERIVADA (createdAt da filha antes/depois do
  // validUntil da mãe), nunca digitada. Mesmo tenant não é garantido
  // pelo FK em si (Postgres não amarra FK a chave composta aqui, mesmo
  // critério de CarrierPayment.reversesPaymentId/
  // ReceivableEvent.reversesReceivableEventId — não pedido, não
  // construído): quem cria passa pelo QuoteService, que só enxerga
  // Quote do próprio tenant via RLS (D-012), então uma Quote de outro
  // tenant nunca é um previousQuoteId alcançável na prática. CHECK na
  // migração impede autorreferência; ciclo de profundidade > 1 é risco
  // aceito, sem detecção construída (ver decisoes.md).
  previousQuoteId      String?       @db.Uuid
  previousQuote        Quote?        @relation("QuoteRevision", fields: [previousQuoteId], references: [id])
  revisions            Quote[]       @relation("QuoteRevision")
  // Quantidade de viagens cotadas (unidade "caminho CUSTO → Order") —
  // evidência real: e-mail cotando 4 contêineres com lacre individual,
  // planilha com um processo de 5 caminhões (CT-e 7581-7585). NOT NULL
  // DEFAULT 1 (toda Quote existente e o caminho TABELA, que nunca
  // informa isso, continuam válidos sem migração de dado). CHECK > 0 na
  // migração — sem guarda de NULL: a coluna já é NOT NULL, não há caso
  // NULL a considerar. Congelada no FECHAMENTO, mesmo mecanismo de GRANT
  // de coluna de validUntil (D-046) — close() aceita quantity junto do
  // prazo de validade; sem informar, mantém o valor atual (1, se nunca
  // mudado). accept() usa este valor pra decidir quantas Trip criar.
  quantity             Int           @default(1)
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(3)
  orders               Order[]
  // Linhas de custo (D-041) — só existem no caminho CUSTO. Tabela filha,
  // nunca coluna fixa (mesmo critério de PickupOrderItem/CarrierPayment):
  // custo novo é INSERT, não migração.
  costLines            QuoteCostLine[]

  @@index([tenantId, statusId])
}

// Tipo de custo de viagem (D-041) — lista de domínio em tabela, não enum
// (D-020): tenantId nulo = padrão do sistema, preenchido = tipo próprio
// daquele tenant. Mesmo padrão de DeductionReason/QuoteStatus. Custo novo
// (ex.: "descarga") é INSERT nesta tabela, nunca migração — é exatamente
// o que a tabela existe pra resolver.
model QuoteCostType {
  id        String          @id @db.Uuid
  tenantId  String?         @db.Uuid
  tenant    Tenant?         @relation(fields: [tenantId], references: [id])
  code      String
  name      String
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  costLines QuoteCostLine[]

  @@unique([tenantId, code])
}

// Linha de custo da viagem (D-041) — tabela filha, nunca coluna fixa
// (mesmo critério de PickupOrderItem/CarrierPayment). Só existe no
// caminho CUSTO de Quote (freightRateId nulo) — nada no banco impede
// gravar numa Quote do caminho TABELA, mas o QuoteService não abre esse
// caminho (D-030: regra de negócio na aplicação, não em CHECK que
// precisaria enxergar a linha pai).
//
// Sem branchId: Quote não tem (é registro de precificação da empresa,
// não movimento de filial, D-011) — filha herda a mesma ausência.
//
// Imutável por inteiro desde a criação (UPDATE/DELETE revogados, sem
// exceção de coluna) — mesmo critério de PickupOrderItem/CarrierPayment.
// "Congela no fechamento" (D-041) fica satisfeito de graça: a linha
// nunca foi editável, então não há nada extra a congelar nela quando a
// Quote fecha — o que o fechamento congela de fato são as alíquotas, a
// margem e o preço (colunas em Quote).
model QuoteCostLine {
  id          String        @id @db.Uuid
  tenantId    String        @db.Uuid
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  quoteId     String        @db.Uuid
  quote       Quote         @relation(fields: [quoteId], references: [id])
  costTypeId  String        @db.Uuid
  costType    QuoteCostType @relation(fields: [costTypeId], references: [id])
  description String?
  // Escala de valor final (D-013) — é um custo estimado em reais, não uma
  // tarifa unitária.
  amount      Decimal       @db.Decimal(14, 2)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)

  @@index([tenantId, quoteId])
}

// Tipo de tributo (D-041) — fixo pelo sistema, nunca varia por tenant
// (D-020, mesmo critério de UserRole/PaymentEventType): nenhum tenant
// "customiza" ICMS/IBS/CBS, são valores de lei.
enum TaxType {
  ICMS
  IBS
  CBS
}

// Distingue as três formas de incidência de ICMS que a D-043 (consulta
// tributária, docs/consulta-tributaria-2026-09.md) exige — só existe
// (não nulo) quando taxType=ICMS:
// - INTERNA: origem e destino na mesma UF — alíquota própria de cada UF
//   (as 27 linhas já semeadas, uf preenchido).
// - INTERESTADUAL_7 / INTERESTADUAL_12: regra do Senado — depende de
//   GRUPO de UF de origem/destino, não do par específico (não é matriz
//   27x27). uf é nulo nessas duas linhas — a alíquota não pertence a
//   uma UF, pertence à combinação de grupos, resolvida em código
//   (TaxRateService.findInterstateIcmsRate) contra uma classificação
//   fixa por lei (Resolução do Senado — geografia constitucional, não
//   domínio configurável por tenant, D-020: "lista fixa por lei
//   permanece enum", mesmo critério de AnttCategory).
// Intramunicipal (mesmo município) não é linha de TaxRate — não tem
// vigência própria, é fronteira de competência tributária (ICMS vs.
// ISS), não uma alíquota que a UF pode mudar por lei. Ver
// TaxRateService.ICMS_INTRAMUNICIPAL_RATE.
enum IcmsOperationType {
  INTERNA
  INTERESTADUAL_7
  INTERESTADUAL_12
}

// Alíquota de tributo com vigência (D-041), mesmo mecanismo do
// FreightRate (D-014): sem vigência, recotar março em setembro produz
// número diferente do que foi cobrado em março, e alíquota muda por lei
// — não é hipótese.
//
// SEM tenantId, deliberadamente — diferente de QuoteStatus/
// DeductionReason/QuoteCostType. Aquelas são listas de domínio que um
// tenant legitimamente pode customizar (D-020); alíquota de tributo não
// é configuração de tenant, é lei — dar a um tenant o poder de "definir
// sua própria alíquota" não é o mesmo risco que "definir seu próprio
// status de pedido". RLS continua obrigatório (guarda de schema exige em
// toda tabela, D-012) mas a política é `USING (true)` — mesmo mecanismo
// já usado no SELECT de Tenant.slug (D-029, pré-login): não há fronteira
// de tenant nenhuma pra impor aqui. mash_app só tem SELECT (GRANT na
// migração revoga INSERT/UPDATE/DELETE) — mudar alíquota é migração
// revisada, nunca escrita da aplicação. Não invento autoridade sobre
// valor de lei (CLAUDE.md 1.6): ver decisoes.md D-041/D-043 pros valores
// marcados "a calibrar com o contador".
//
// uf: nulo = nacional (IBS/CBS) OU ICMS interestadual (a alíquota não é
// de uma UF só, D-043); preenchido = ICMS interna daquela UF. CHECK na
// migração amarra isso a icmsOperationType, não só a taxType — antes da
// D-043 "uf nulo" só significava IBS/CBS; agora também pode ser ICMS
// interestadual, e o CHECK precisa das duas colunas juntas pra
// desambiguar.
//
// composesPrice (D-043, correção — antes o pipeline somava IBS/CBS ao
// preço incondicionalmente): durante a calibragem (2026), IBS/CBS são
// informativos — calculados e destacados no documento, mas NÃO somam ao
// valor cobrado do cliente (docs/consulta-tributaria-2026-09.md). A
// etapa de cálculo continua existindo; o que muda é se o resultado entra
// na composição do preço final, e isso tem vigência igual a alíquota —
// por isso é coluna nesta linha, não constante no código. ICMS sempre
// `true` (sempre esteve "por dentro" do preço, isso não mudou).
model TaxRate {
  id                String             @id @db.Uuid
  taxType           TaxType
  uf                String?            @db.Char(2)
  icmsOperationType IcmsOperationType?
  // Escala de percentual (D-013, que já cita ICMS como exemplo textual
  // de numeric(7,4)).
  rate      Decimal  @db.Decimal(7, 4)
  // Datas de calendário, não timestamp (D-016) — vigência de lei não tem
  // hora.
  validFrom DateTime @db.Date
  validTo   DateTime @db.Date
  // Marca alíquota-placeholder — valor plausível, não pesquisado, "a
  // calibrar com o contador" (D-041). As 27 linhas de ICMS interna
  // semeadas nascem `true`; IBS/CBS e ICMS interestadual (dado real —
  // LC 214/2025 e Resolução do Senado, D-043) nascem `false`. Um
  // comentário na migração não impede ninguém de usar o placeholder em
  // produção — TaxRateService.findRate() recusa devolver uma linha
  // `isPlaceholder = true` fora de dev/test (NODE_ENV), e é essa recusa
  // em código, não este comentário, que garante a coisa.
  isPlaceholder Boolean @default(false)
  // D-043 — ver comentário acima do model.
  composesPrice Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([taxType, uf])
  @@index([taxType, icmsOperationType])
}

// Situação/classificação tributária de IBS/CBS por documento (D-043) —
// tabela de dado, não enum: mesmo critério da D-020 (tenantId nulo =
// padrão do sistema). A tabela oficial do Portal Nacional tem mais de
// 160 combinações de CST+cClassTrib, atualizada por Nota Técnica — um
// enum travaria no primeiro caso não previsto e exigiria migração pra
// cada atualização da tabela oficial. Semeado só o caso padrão de
// transporte rodoviário de carga tributado integralmente (CST 000 +
// cClassTrib 000001) — não a tabela completa (pendência registrada em
// docs/decisoes.md D-043: atualização periódica a partir do Portal
// Nacional).
//
// cst/cClassTrib são os nomes literais do XML/schema do CT-e (D-007,
// mesmo critério de Address não traduzir logradouro/município) — não
// confundir com o CST de ICMS "clássico" (00/90), que é conceito
// diferente e não vive nesta tabela.
//
// Sem FK de Quote pra cá ainda — não pedido nesta unidade. Mesma
// pendência já registrada pra valoresPrestacao.componentes (D-041): o
// lado do PREÇO decomposto por componente/situação fiscal ainda não foi
// modelado, só o lado do CUSTO (QuoteCostLine) existe.
model IbsCbsTaxSituation {
  id        String   @id @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  cst       String   @db.Char(3)
  cClassTrib String  @db.Char(6)
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, cst, cClassTrib])
}

// Pedido (D-018). branchId obrigatório: movimento é da filial (D-011) —
// diferente de Quote/FreightRate/Party, que são cadastro/precificação
// da empresa.
//
// Congela os valores aplicados nos dois caminhos de precificação — via
// Quote fechada ou consultando FreightRate direto na criação (D-018).
// freightRateId é sempre preenchido (referência de auditoria); quoteId só
// quando veio de uma cotação.
//
// Sender, recipient e tomador são relacionamentos separados com a mesma
// Party — nunca um "tipo" no cadastro (D-018: Party é uma parte, não um
// papel). Tomador é campo próprio e obrigatório, nunca inferido dos
// outros dois.
//
// senderId/recipientId em inglês, tomadorId em português (D-007,
// corrigido 04/09/2026): "remetente"/"destinatário" traduzem sem perda —
// são só quem despacha e quem recebe, sem efeito jurídico distinto do
// inglês. "Tomador" tem definição fiscal real (determina destaque de
// ICMS e destino da fatura, D-018) — isso é o que a exceção do D-007
// protege, não "o XML usa essa palavra". Detalhe em docs/decisoes.md.
//
// Order 1:N Trip — Trip ainda não existe. Nada aqui impede isso: é a
// tabela filha (Trip.orderId) que vai carregar a referência, não o
// contrário.
//
// Lista de domínio em tabela, não enum (D-020) — mesmo padrão do
// QuoteStatus: tenantId nulo = padrão do sistema, preenchido = status
// próprio daquele tenant. Achado nº 4 da auditoria de modelo (D-036):
// Order não tinha como representar "não vale" — diferente de Quote/Trip.
// Sem isPublic (diferente de TripStatus/OccurrenceType): a distinção
// interno/público do D-010 hoje mora no status da VIAGEM, não do pedido
// — nada pede essa taxonomia aqui ainda, não inventada.
//
// Evidência de campo (planilha real, D-037/D-038): coluna STATUS com
// FINALIZADO/ANDAMENTO/CANCELADO em uso — só esses três semeados,
// não a taxonomia completa.
model OrderStatus {
  id        String   @id @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  code      String
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  orders    Order[]

  @@unique([tenantId, code])
}

// Sem UPDATE liberado a mash_app além de statusId/updatedAt (D-038): nada
// mais nesta tabela muda legitimamente depois de criada — mesmo mecanismo
// de imutabilidade do FreightRate/Quote, aplicado ao conjunto de colunas
// mutáveis que agora tem exatamente uma (statusId). number, valores
// congelados e as três Party continuam fora do alcance do UPDATE — status
// não reabre número de negócio (D-015): DocumentCounter não tem nenhum
// caminho que reaja a mudança de status, então cancelar não libera o
// número pra reuso. DELETE também revogado (D-017: movimento financeiro
// nunca se apaga — "cancelado" é estado, não remoção).
model Order {
  id                   String      @id @db.Uuid
  tenantId             String      @db.Uuid
  tenant               Tenant      @relation(fields: [tenantId], references: [id])
  branchId             String      @db.Uuid
  branch               Branch      @relation(fields: [branchId], references: [id])
  // Número de negócio (D-015) — nunca a PK, nunca aparece como UUID pro
  // operador. Atribuído por DocumentCounter (mesmo mecanismo que vai
  // servir CT-e/fatura), dentro da MESMA transação do INSERT desta linha
  // — só assim um rollback desfaz as duas coisas juntas (por isso nunca
  // SEQUENCE, cujo nextval() nunca é desfeito). Único dentro de
  // tenant+branch, garantido no banco.
  number               Int
  // Referência do cliente (D-038) — é por ESSE número que o operador acha
  // o pedido o dia inteiro, não pelo number interno da transportadora
  // (evidência: coluna PROCESSO da planilha, formatos livres por cliente:
  // "PRA 7497/24", "001-OP-I-6403", "32584/25-IMA"). Opcional: nem todo
  // cliente manda uma. Busca via índice trigram (ver migração) — formatos
  // sem prefixo comum, índice btree comum não ajudaria em "contém".
  customerReference    String?
  // Único (unidade "caminho CUSTO → Order"): uma cotação produz no
  // máximo um pedido — o banco garante (Postgres trata NULL como
  // distinto num índice único comum, então N Order com quoteId nulo,
  // caminho createFromFreightRate, continuam livres).
  quoteId              String?     @unique @db.Uuid
  quote                Quote?      @relation(fields: [quoteId], references: [id])
  // Nuláveis (unidade "caminho CUSTO → Order"): caminho TABELA continua
  // preenchendo os quatro sempre; caminho CUSTO (via Quote sem
  // FreightRate) deixa os quatro nulos — total já cobre o preço nesse
  // caso. CHECK "Order_pricing_path_exclusive" na migração garante que
  // não se misturam, mesmo mecanismo do Quote_pricing_path_exclusive
  // (D-041).
  freightRateId        String?     @db.Uuid
  freightRate          FreightRate? @relation(fields: [freightRateId], references: [id])
  senderId             String      @db.Uuid
  sender               Party       @relation("OrderSender", fields: [senderId], references: [id])
  recipientId          String      @db.Uuid
  recipient            Party       @relation("OrderRecipient", fields: [recipientId], references: [id])
  tomadorId            String      @db.Uuid
  tomador              Party       @relation("OrderTomador", fields: [tomadorId], references: [id])
  // Congelado na criação — cópia, não consulta. Escalas de D-013.
  rate                 Decimal?    @db.Decimal(18, 6)
  minimumFreight       Decimal?    @db.Decimal(14, 2)
  additionalPercentage Decimal?    @db.Decimal(7, 4)
  total                Decimal     @db.Decimal(14, 2)
  // Único campo que legitimamente mudava depois da criação até D-042 —
  // nasce "em andamento", UPDATE liberado a mash_app.
  statusId             String      @db.Uuid
  status               OrderStatus @relation(fields: [statusId], references: [id])
  // Fatura que agrupa este pedido (D-042) — nulo até ser faturado. Sem
  // tabela de junção: evidência é 1 Order pertence a no máximo 1 Invoice,
  // não N:N (CLAUDE.md 2, sem estrutura que ninguém pediu). GRANT UPDATE
  // por coluna, mesmo mecanismo de statusId — banco permite reatribuir
  // indefinidamente (mesmo risco já aceito em statusId/D-038 e
  // FreightRate.validTo/D-014: disciplina de uso é da aplicação, não
  // travada em CHECK que precisaria enxergar o valor anterior).
  invoiceId            String?     @db.Uuid
  invoice              Invoice?    @relation(fields: [invoiceId], references: [id])
  createdAt            DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @db.Timestamptz(3)
  trips                Trip[]

  @@unique([tenantId, branchId, number])
  @@index([tenantId, branchId])
  @@index([tenantId, statusId])
  @@index([tenantId, invoiceId])
}

// Lista de domínio em tabela, não enum (D-020) — mesmo padrão do
// QuoteStatus: tenantId nulo = padrão do sistema. isPublic distingue
// status interno de público (D-010, assento reservado para o portal do
// embarcador) — "aguardando liberação de risco" nasce isPublic=false;
// operação não expõe isso a quem só acompanha a carga.
model TripStatus {
  id        String   @id @db.Uuid
  tenantId  String?  @db.Uuid
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  code      String
  name      String
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  trips     Trip[]

  @@unique([tenantId, code])
}

// Resultado normalizado da liberação de risco (D-023, auditoria de modelo
// 08/09/2026) — os quatro resultados que a D-023 cita nominalmente:
// "recomendado" (implícito, é o oposto de "não recomendado" — confirmado
// como vocabulário do setor pelo dado de teste já existente antes desta
// mudança) e os três que impedem embarque. Fixo pelo sistema, não varia
// por tenant (D-020, mesma exceção de AnttCategory/CarrierBondType) — é o
// resultado NORMALIZADO que o operador registra depois de consultar
// qualquer gerenciadora (Buonny, Opentech, Global5, Nox...), não o texto
// cru de cada provedor; por isso enum é seguro apesar do vocabulário de
// provedor variar (a normalização é regra de quem registra, não do
// banco). Valores em português: vocabulário do próprio setor de gestão de
// risco, sem tradução natural em uso (mesmo critério de VehicleType).
enum RiskClearanceResult {
  RECOMENDADO
  NAO_RECOMENDADO
  INEXISTENTE
  NAO_AUTORIZADO
}

// Ficha de liberação de risco (D-023) — só registro do resultado já
// obtido na gerenciadora (Buonny, Opentech, Global5, Nox...), sem
// integração. number em texto livre: numeração própria de cada
// gerenciadora, não é regra estável o bastante pra fixar formato (seção
// 1.6). "Proprietário" é texto livre também — não existe cadastro de dono
// de veículo no modelo hoje, e criar um não foi pedido.
// Sem branchId: é dado sobre o par motorista+veículo, não da operação de
// uma filial (D-011, mesmo critério de Driver/Vehicle).
//
// Imutável por inteiro (correção 08/09/2026, auditoria de modelo): é
// evidência de conformidade com a apólice — "o não cumprimento faz perder
// o direito à indenização" (D-023) — e essa garantia vale tanto para
// DELETE quanto para UPDATE. A migração original só revogava DELETE
// ("um registro apagado depois de um sinistro é pior que não ter
// registro nenhum") e deixava UPDATE aberto por engano: o comentário que
// justificava isso (`add_trip/migration.sql`) falava de Trip mudar
// legitimamente ao longo da viagem, não de RiskClearance — uma ficha
// "não recomendado" podia virar "liberado" depois do fato, sem rastro
// nenhum, o mesmo risco que já tinha justificado revogar DELETE. Nenhuma
// coluna aqui legitimamente muda depois de criada: a ficha nasce completa
// (número, motorista, veículo, proprietário, data, validade, resultado —
// D-023), não em rascunho. UPDATE revogado por inteiro do role de
// aplicação, sem exceção de coluna — mesmo critério de CarrierPayment/
// PickupOrder (D-017).
model RiskClearance {
  id         String              @id @db.Uuid
  tenantId   String              @db.Uuid
  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  number     String
  driverId   String              @db.Uuid
  driver     Driver              @relation(fields: [driverId], references: [id])
  vehicleId  String              @db.Uuid
  vehicle    Vehicle             @relation(fields: [vehicleId], references: [id])
  ownerName  String
  // Datas de calendário, não timestamp (D-016).
  checkDate  DateTime            @db.Date
  validUntil DateTime            @db.Date
  result     RiskClearanceResult
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @db.Timestamptz(3)
  trips      Trip[]

  @@index([tenantId, driverId, vehicleId])
}

// Viagem (D-018). branchId obrigatório: movimento é da filial (D-011).
//
// Um destino por Trip — o CT-e aceita um só endereço de recebimento
// (D-018, "Validado em campo"). Um Order vira várias Trip quando há mais
// de um local de entrega.
//
// Composição de veículo pertence à viagem, não ao cadastro (D-018):
// vehicleId é o veículo principal (cavalo mecânico OU um TRUCK/TOCO
// rígido sozinho); trailer1Id/trailer2Id só existem quando o principal é
// articulado. Nenhum CHECK cruza isso com Vehicle.type — validar que
// "trailer preenchido só faz sentido com cavalo mecânico" é regra de
// negócio, não integridade sob concorrência (D-030), fica pra aplicação.
//
// Motorista e veículo próprios ou de terceiro (D-019): driverId/vehicleId
// referenciam Driver/Vehicle igual, sem distinção de campo — a distinção
// já mora em Driver.employmentType e Vehicle.ownerPartyId.
//
// riskClearanceId opcional: a viagem existe enquanto aguarda a liberação
// (D-023) — por isso também nasce sem ela, status "aguardando liberação
// de risco" (interno, D-010) cobre essa espera.
//
// DELETE revogado do role de aplicação: Trip é movimento (D-018), e
// movimento nunca se apaga — "cancelada" é estado (status), não remoção
// (D-017, mesmo critério de Quote/Order/FreightRate).
model Trip {
  id                   String         @id @db.Uuid
  tenantId             String         @db.Uuid
  tenant               Tenant         @relation(fields: [tenantId], references: [id])
  branchId             String         @db.Uuid
  branch               Branch         @relation(fields: [branchId], references: [id])
  orderId              String         @db.Uuid
  order                Order          @relation(fields: [orderId], references: [id])
  // Ordem da perna dentro do pedido — transbordo é real (sócio, campo:
  // ~1 em 8 viagens tem armazenagem/crossdocking intermediário antes do
  // destino final), então um Order pode ter mais de uma Trip em sequência.
  // Único dentro do Order, mas NÃO precisa ser contíguo: perna cancelada
  // pode deixar buraco sem consequência (diferente da numeração de CT-e,
  // D-015 — lá buraco exige inutilização junto à SEFAZ). Encadeamento de
  // endereço (destino da perna N = origem da perna N+1) é regra de
  // aplicação, não constraint — pode haver exceção operacional.
  sequence             Int
  // Preço unitário desta viagem (unidade "caminho CUSTO → Order") —
  // copiado de Quote.total no momento da criação (accept()), nunca
  // recalculado depois (D-014, mesmo critério de Order.rate/total).
  // Escala de valor final (D-013), igual Order.total/QuoteCostLine.amount.
  // Anulável (corrigido depois do primeiro `migrate deploy` desta
  // migração, ainda na mesma sessão): NOT NULL quebrou ~20 arquivos de
  // teste pré-existentes que criam Trip direto pra exercitar outra
  // coisa (RLS, sequence, status, PickupOrder...) sem contexto de
  // cotação nenhum — "preço" não é atributo universal de Trip, só das
  // que nascem de accept().
  price                Decimal?       @db.Decimal(14, 2)
  // Nuláveis (unidade "caminho CUSTO → Order", deliberado, não lacuna):
  // motorista, veículo e destino são preenchidos NA OPERAÇÃO, não na
  // cotação — accept() cria a Trip sem nenhum dos três. Mesmo motivo
  // para destinationAddressId quanto para driverId/vehicleId: Quote não
  // carrega rota nenhuma (nem Lane, nem Address — icmsUf é só a UF do
  // ICMS, D-041), então não há de onde copiar um endereço no caminho
  // CUSTO. Sem GRANT restrito aqui: Trip nunca teve REVOKE de UPDATE
  // (só DELETE, abaixo) — quando existir TripService, atribuir os três
  // depois já funciona com o GRANT default.
  destinationAddressId String?        @db.Uuid
  destinationAddress   Address?       @relation(fields: [destinationAddressId], references: [id])
  driverId             String?        @db.Uuid
  driver               Driver?        @relation(fields: [driverId], references: [id])
  vehicleId            String?        @db.Uuid
  vehicle              Vehicle?       @relation("TripVehicle", fields: [vehicleId], references: [id])
  trailer1Id           String?        @db.Uuid
  trailer1             Vehicle?       @relation("TripTrailer1", fields: [trailer1Id], references: [id])
  trailer2Id           String?        @db.Uuid
  trailer2             Vehicle?       @relation("TripTrailer2", fields: [trailer2Id], references: [id])
  riskClearanceId      String?        @db.Uuid
  riskClearance        RiskClearance? @relation(fields: [riskClearanceId], references: [id])
  statusId             String         @db.Uuid
  status               TripStatus     @relation(fields: [statusId], references: [id])
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)
  // Contratação de terceiro (D-019) — 1:1, só existe quando a viagem é
  // terceirizada. FK vive em CarrierHire (dependente carrega a
  // referência), não aqui — mesmo critério de Address -> Party.
  carrierHire          CarrierHire?
  // Eventos da viagem (D-018) — FK vive em Occurrence, não aqui, mesmo
  // critério de CarrierHire.
  occurrences          Occurrence[]
  // Ordem de coleta (D-027) — FK vive em PickupOrder, não aqui, mesmo
  // critério de CarrierHire/Occurrence. 1:N: uma Trip pode ter mais de
  // uma emissão ao longo do tempo (correção é emitir de novo, não editar).
  pickupOrders         PickupOrder[]

  @@unique([orderId, sequence])
  @@index([tenantId, branchId])
  @@index([tenantId, orderId])
  @@index([tenantId, statusId])
}

// Motivo de desconto no pagamento ao terceiro: avaria, diária, multa,
// abastecimento descontado do frete (D-026). Lista de domínio em
// tabela, não enum (D-020) — varia por tenant. Mesmo padrão de
// QuoteStatus/TripStatus: tenantId nulo = padrão do sistema.
model DeductionReason {
  id        String           @id @db.Uuid
  tenantId  String?          @db.Uuid
  tenant    Tenant?          @relation(fields: [tenantId], references: [id])
  code      String
  name      String
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)
  payments  CarrierPayment[]

  @@unique([tenantId, code])
}

// Tipo de evento do livro de pagamento ao terceiro (D-019) — vocabulário
// fixo do sistema (como se soma ou subtrai do saldo), não varia por
// tenant, por isso enum e não tabela (D-020, mesmo critério de UserRole).
enum PaymentEventType {
  ADVANCE
  BALANCE
  DEDUCTION
  REVERSAL
}

// Contratação da viagem com terceiro (D-019, Party renomeado de Customer
// pela D-032). branchId obrigatório:
// movimento é da filial (D-011), mesmo critério de Order/Trip.
//
// Só agreedFreight é valor congelado aqui (D-014). Adiantamento e saldo
// não são coluna: saldo é derivado somando CarrierPayment (nunca
// gravado) — cada parcela ou desconto como coluna única viraria UPDATE
// em valor financeiro, proibido pelo histórico de D-017.
//
// CIOT é preenchido depois da contratação (emitido fora do sistema, antes
// da viagem sair) — por isso é a única coluna com UPDATE liberado (GRANT
// por coluna na migração), junto de updatedAt. tripId/thirdPartyId/
// agreedFreight congelam, mesmo mecanismo do Quote. Vale-pedágio saiu
// daqui na D-036 (auditoria de modelo, 08/09/2026) — virou tabela filha
// append-only, TollVoucherPurchase, porque era editável sem histórico e
// alimenta o MDF-e (D-014: documento fiscal é append-only).
//
// DELETE revogado: é histórico financeiro (D-017).
model CarrierHire {
  id           String @id @db.Uuid
  tenantId     String @db.Uuid
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  branchId     String @db.Uuid
  branch       Branch @relation(fields: [branchId], references: [id])
  tripId       String @unique @db.Uuid
  trip         Trip   @relation(fields: [tripId], references: [id])
  thirdPartyId String @db.Uuid
  thirdParty   Party  @relation("CarrierHireThirdParty", fields: [thirdPartyId], references: [id])

  // Escala de valor final (D-013).
  agreedFreight Decimal @db.Decimal(14, 2)

  // CIOT existe na contratação de TAC, não de ETC (nullable). Só o
  // número: os valores do CIOT já estão em agreedFreight/CarrierPayment
  // — gravar de novo seria segunda fonte de verdade sobre o mesmo
  // dinheiro.
  ciotNumber String?

  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  payments             CarrierPayment[]
  tollVoucherPurchases TollVoucherPurchase[]

  @@index([tenantId, branchId])
}

// Compra de vale-pedágio (D-019/D-028/D-032) — movida de CarrierHire para
// tabela filha append-only na D-036 (auditoria de modelo, 08/09/2026):
// como três colunas mutáveis em CarrierHire, o valor podia ser
// sobrescrito sem histórico, e o MDF-e (D-028) vai referenciar esse
// valor — documento fiscal é append-only (D-014), então o que alimenta um
// não pode ser editável em silêncio. Mesmo critério de CarrierPayment
// (D-017): correção é linha nova, nunca edição. Resolve de graça a
// pendência da D-032 — "se uma viagem puder ter mais de uma compra de
// vale-pedágio, os três campos viram tabela 1:N" — porque já nasce 1:N.
//
// Vale-pedágio nunca compõe o frete nem vira CarrierPayment tipo
// DEDUCTION (D-032) — não é frete, não é base de tributo; por isso segue
// fora do livro de CarrierPayment, só referenciando CarrierHire.
//
// Campos opcionais, mesmo critério de antes (seção 1.6): leiaute exato do
// grupo de vale-pedágio do MDF-e ainda não confirmado com o provedor —
// obrigatoriedade fica pendente dessa confirmação (D-032, pendência
// técnica em decisoes.md), não decidida aqui.
//
// Sem branchId: é filho de CarrierHire, que já carrega (D-011, mesmo
// critério de CarrierPayment não duplicar o que o pai já modela).
//
// UPDATE e DELETE revogados por inteiro do role de aplicação — nenhuma
// coluna aqui legitimamente muda depois de criada, mesmo critério de
// CarrierPayment/PickupOrder.
model TollVoucherPurchase {
  id            String      @id @db.Uuid
  tenantId      String      @db.Uuid
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  carrierHireId String      @db.Uuid
  carrierHire   CarrierHire @relation(fields: [carrierHireId], references: [id])

  tollVoucherSupplierCnpj   String?  @db.VarChar(14)
  tollVoucherPurchaseNumber String?
  tollVoucherAmount         Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, carrierHireId])
}

// Evento de pagamento ao terceiro — livro append-only (D-017: nenhuma
// parcela ou desconto financeiro sofre UPDATE; correção é estorno, linha
// nova, nunca edição da linha original). Saldo do CarrierHire é
// SUM(grossAmount) com sinal dado por type, nunca coluna.
//
// grossAmount/netAmount sempre positivos — o sinal/direção vem de type,
// nunca do número (mesmo critério de "banco garante, não confiar em
// disciplina" do D-012/D-014/D-029). netAmount é o que foi efetivamente
// transferido — pagamento a TAC pessoa física tem retenção, por isso
// separado do valor bruto que compõe o saldo; nunca maior que o bruto
// (CHECK na migração — retenção não é negativa).
//
// netAmount é NOT NULL (correção 08/09/2026, auditoria de modelo): era
// opcional, e o CHECK "netAmount <= grossAmount" não pega NULL (Postgres
// aprova CHECK sempre que a comparação avalia NULL) — então nada no banco
// distinguia "sem retenção" de "não informado". Um SUM(netAmount) sobre
// o livro excluiria em silêncio toda linha sem o campo preenchido,
// subestimando o valor líquido pago sem erro nenhum. Sem retenção,
// netAmount = grossAmount, preenchido explicitamente pelo chamador —
// nunca inferido pelo banco (não há trigger, D-030).
//
// Sem branchId: é filho de CarrierHire, que já carrega — mesmo critério
// do Address não duplicar o que o Party já modela.
//
// UPDATE e DELETE revogados por inteiro (não GRANT de coluna como
// FreightRate/Quote/CarrierHire): nenhuma coluna aqui legitimamente
// muda depois de criada.
model CarrierPayment {
  id            String           @id @db.Uuid
  tenantId      String           @db.Uuid
  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  carrierHireId String           @db.Uuid
  carrierHire   CarrierHire      @relation(fields: [carrierHireId], references: [id])
  type          PaymentEventType

  grossAmount Decimal @db.Decimal(14, 2)
  netAmount   Decimal @db.Decimal(14, 2)

  deductionReasonId String?          @db.Uuid
  deductionReason   DeductionReason? @relation(fields: [deductionReasonId], references: [id])

  // Correção obrigatória (D-017): REVERSAL sempre aponta pro pagamento
  // que desfaz — CHECK na migração amarra nos dois sentidos (só REVERSAL
  // preenche, REVERSAL sempre preenche) e um índice único parcial
  // impede estornar o mesmo pagamento duas vezes. Não valida (nem CHECK
  // nem trigger) que o pagamento revertido pertence ao mesmo
  // CarrierHire, nem que o valor bate — não pedido, ficaria pra
  // aplicação se um dia importar.
  reversesPaymentId String?          @db.Uuid
  reversesPayment   CarrierPayment?  @relation("PaymentReversal", fields: [reversesPaymentId], references: [id])
  reversedBy        CarrierPayment[] @relation("PaymentReversal")

  // Data de calendário, não timestamp (D-016) — data do pagamento não
  // tem hora própria relevante ao domínio.
  paymentDate   DateTime @db.Date
  // Texto livre: sem vocabulário estável o bastante pra fixar em enum
  // agora (seção 1.6) — diferente de PaymentEventType, que é lógica do
  // sistema, não convenção bancária.
  paymentMethod String?
  reference     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, carrierHireId])
}

// Categoria ANTT do transportador — fixo por regulação do setor, não varia
// por tenant (D-020, mesma exceção de VehicleType/UserRole). CTC
// (Cooperativa de Transporte de Cargas) é PJ mas não é ETC — personType
// (PF/PJ) da Party não substitui esta classificação (D-032).
enum AnttCategory {
  TAC
  ETC
  CTC
}

// Vínculo comercial do terceiro — fixo pelo sistema, não varia por tenant
// (D-020, mesma exceção de PaymentEventType). Determina a validade da
// ficha de liberação de risco (D-023: ~6 meses agregado, por viagem para
// autônomo/spot). Valores em português: vocabulário do próprio setor de
// transporte rodoviário, sem tradução natural em uso (mesmo critério de
// VehicleType, D-007).
enum CarrierBondType {
  SPOT
  AGREGADO
}

// Perfil de transportador contratável (D-019/D-023, campos que a dívida de
// nomenclatura da D-032 registrou como faltantes). Existência opcional
// 1:1 com Party — é o perfil que torna a parte contratável como terceiro,
// não um "tipo" a mais no cadastro; CarrierHire.thirdPartyId continua
// aceitando qualquer Party, a obrigatoriedade do perfil é regra de
// aplicação, quando o serviço existir, não constraint de banco.
//
// rntrc: texto livre, sem CHECK de formato — mesmo critério de
// Vehicle.renavam (seção 1.6, não é regra estável o bastante pra fixar de
// memória).
//
// bondType alimenta a validade da ficha de liberação (RiskClearance,
// D-023) quando esse cálculo existir — não modelado aqui, é regra de
// aplicação, não de banco (D-030).
model CarrierProfile {
  id           String          @id @db.Uuid
  tenantId     String          @db.Uuid
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  partyId      String          @unique @db.Uuid
  party        Party           @relation(fields: [partyId], references: [id])
  rntrc        String
  anttCategory AnttCategory
  bondType     CarrierBondType
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)

  @@index([tenantId])
}

// Lista de domínio em tabela, não enum (D-020) — a D-020 cita "tipos de
// ocorrência" nominalmente como lista que varia por transportadora.
// Mesmo padrão de QuoteStatus/TripStatus/DeductionReason: tenantId nulo
// = padrão do sistema, preenchido = daquele tenant.
//
// isPublic mora aqui, não em Occurrence — espelha TripStatus (D-010): é
// o TIPO de evento que determina se o cliente pode ver, não a instância.
// Deixar na ocorrência reabriria por instância a pergunta que o
// vocabulário já responde, e permitiria duas ocorrências do mesmo tipo
// divergirem em visibilidade por decisão de quem registrou.
model OccurrenceType {
  id          String       @id @db.Uuid
  tenantId    String?      @db.Uuid
  tenant      Tenant?      @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  isPublic    Boolean      @default(false)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  occurrences Occurrence[]

  @@unique([tenantId, code])
}

// Evento da viagem (D-018) — alimenta o portal do embarcador (D-010),
// onde a distinção interna/pública de OccurrenceType.isPublic vai ser
// usada para filtrar o que o cliente enxerga. branchId obrigatório:
// movimento é da filial (D-011), mesmo critério de Order/Trip/CarrierHire.
//
// occurredAt (quando o fato aconteceu na estrada) é distinto de
// createdAt (quando foi lançado no sistema) — não são a mesma coisa,
// ocorrência da madrugada lançada de manhã é rotina. CHECK no banco
// garante occurredAt <= createdAt, não só disciplina da aplicação
// (mesmo critério de D-012/D-014/D-029).
//
// Fora de escopo, não construído aqui: ocorrência mudando status da
// viagem (seria regra de aplicação, não trigger, D-030) e anexo/foto
// (não existe armazenamento de arquivo no projeto ainda).
//
// DELETE revogado do role de aplicação: é registro do que aconteceu e
// vai para o cliente pela D-010 — mesmo critério de RiskClearance
// (D-023/D-017), apagar depois é pior que não ter registrado. UPDATE só
// libera description e updatedAt (GRANT por coluna, mesmo mecanismo do
// CarrierHire) — tipo, viagem, filial e occurredAt não mudam depois de
// registrados.
model Occurrence {
  id          String         @id @db.Uuid
  tenantId    String         @db.Uuid
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  branchId    String         @db.Uuid
  branch      Branch         @relation(fields: [branchId], references: [id])
  tripId      String         @db.Uuid
  trip        Trip           @relation(fields: [tripId], references: [id])
  typeId      String         @db.Uuid
  type        OccurrenceType @relation(fields: [typeId], references: [id])
  description String
  occurredAt  DateTime       @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  @@index([tenantId, branchId])
  @@index([tenantId, tripId])
  @@index([tenantId, typeId])
}

// Período do dia (janela de tempo em linguagem natural — pendência técnica
// de decisoes.md, tipo `TimeWindow`/`DayPeriodCode` já em
// `shared/src/time-window`, D-020). Lista de domínio em tabela, não enum
// — mesmo padrão de OrderStatus/QuoteCostType: tenantId nulo = padrão do
// sistema, catálogo compartilhado (RLS libera leitura E escrita em
// tenantId IS NULL, não isolamento padrão). Código em inglês (D-007), name
// carrega o rótulo em português (D-008) — é o rótulo que formatTimeWindow
// usa (o pacote compartilhado não guarda tradução, só o código).
//
// Nove códigos, todos confirmados em dado real (planilha operacional de
// 2025, shared/src/time-window/time-window.parser.ts) — não a taxonomia
// completa, mesmo critério que já semeou só três OrderStatus e dois
// TripStatus.
model DayPeriod {
  id           String        @id @db.Uuid
  tenantId     String?       @db.Uuid
  tenant       Tenant?       @relation(fields: [tenantId], references: [id])
  code         String
  name         String
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  pickupOrders PickupOrder[]

  @@unique([tenantId, code])
}

// Ordem de coleta (D-027) — comunicação entre operador e motorista, não
// documento fiscal, emissão opcional pra qualquer Order. Âncora é a Trip,
// não o Order direto: "dados do motorista" só existe de fato em
// Trip.driverId/vehicleId (composição, D-018), e Order 1:N Trip significa
// que cada viagem tem sua própria ordem de coleta — duplicar orderId aqui
// violaria fonte única de verdade (CLAUDE.md 3.2), já dá pra chegar em
// Order via trip.orderId. branchId obrigatório: é movimento (D-011).
//
// addressId referencia um Address já cadastrado (normalmente do sender do
// Order) — não texto livre solto, mesmo critério de Trip.destinationAddressId.
// Nada no banco valida que o Address pertence ao sender da Order (regra de
// negócio, não integridade sob concorrência, D-030) — fica pra aplicação
// se um dia importar.
//
// totalWeightKg/totalCubicMeters: Decimal, nunca number (mesmo cuidado do
// D-013), na mesma escala de Vehicle.capacityKg/tareKg (kg, 3 casas) — não
// é valor monetário, mas seguem o mesmo princípio de nunca usar ponto
// flutuante. totalVolumeCount é contagem de volumes (caixas/pallets),
// inteiro por natureza — "quantidade" no sentido do romaneio, não peso.
//
// Totais são congelados na criação, não derivados da soma de items — mesmo
// critério de Order/Quote (D-014): o que vale é o que foi impresso/
// comunicado, não um recálculo. Não há CHECK nem trigger reconciliando
// items com o total (D-030 não recomenda regra de negócio em trigger; não
// pedido).
//
// Sem número de negócio sequencial próprio: não está na lista de conteúdo
// do D-027, e Order também não tem numeração sequencial ainda (D-015
// antecipa mas não construiu) — não inventado aqui pra não estourar escopo.
//
// nfeReference/romaneioReference: texto livre — NF-e (D-024) e romaneio
// ainda não são entidades no sistema, é o operador anotando a referência
// externa manualmente. businessHours/laborNote: texto livre também (seção
// 1.6 — formato varia demais pra fixar regra).
//
// Janela de tempo estruturada (pickupStartTime/pickupEndTime/
// pickupEndsNextDay/pickupDayPeriodId) — tipo `TimeWindow` de
// `@mash/shared` materializado em coluna (pendência técnica de
// decisoes.md, fechada nesta migração). pickupTimeNote (renomeado de
// pickupWindow) é o que sobra: texto original preservado quando o parser
// não estruturou tudo, ou o próprio texto livre de sempre pra quem
// preenche a tela sem passar pelo parser. As cinco invariantes do tipo
// (dayPeriodId excludente com horário, endsNextDay exige os dois horários
// e end<start, sem endsNextDay end>=start quando os dois existem) são
// impostas por CHECK no banco, não só no TypeScript — mesmo padrão de
// TaxRate (D-043): a garantia mora onde o dado é escrito, não só em quem
// escreve direito.
//
// Hora como texto "HH:mm" (VARCHAR(5)), NÃO time nativo do Postgres: o
// Prisma mapeia @db.Time de volta pra um objeto Date com data de
// 1970-01-01 embutida, reabrindo a confusão de fuso que a D-016 manda
// evitar (hora sem data teria fuso implícito de novo). @mash/shared já
// trata hora como string em todo o pacote — "HH:mm" com zero à esquerda
// ordena corretamente em comparação lexicográfica de texto, então os CHECK
// abaixo (end < start, end >= start) funcionam no banco exatamente como
// funcionariam com um tipo de hora nativo.
//
// pickupDate fica NULLABLE por enquanto — existem PickupOrder de teste sem
// data (seedPickupOrderScenario preenche, mas nada no banco exige). Vira
// NOT NULL quando a tela for a única porta de criação de PickupOrder.
//
// Imutável por inteiro: é movimento (D-011), e corrigir significa emitir
// de novo (nova linha), não editar — mesmo critério de Order/CarrierHire.
// UPDATE e DELETE revogados do role de aplicação, sem exceção de coluna —
// as colunas novas entram só no INSERT, a imutabilidade já cobre tudo.
model PickupOrder {
  id                String            @id @db.Uuid
  tenantId          String            @db.Uuid
  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  branchId          String            @db.Uuid
  branch            Branch            @relation(fields: [branchId], references: [id])
  tripId            String            @db.Uuid
  trip              Trip              @relation(fields: [tripId], references: [id])
  addressId         String            @db.Uuid
  address           Address           @relation(fields: [addressId], references: [id])
  // Complemento livre ao endereço estruturado — "Doca 12", "Pátio de
  // containers" — informação que não é campo de Address (D-024/NF-e).
  locationLabel     String?
  // Data de calendário, não timestamp (D-016) — data da coleta não tem
  // fuso próprio relevante ao domínio. Nullable — ver comentário acima.
  pickupDate        DateTime?         @db.Date
  pickupStartTime   String?           @db.VarChar(5)
  pickupEndTime     String?           @db.VarChar(5)
  pickupEndsNextDay Boolean           @default(false)
  pickupDayPeriodId String?           @db.Uuid
  pickupDayPeriod   DayPeriod?        @relation(fields: [pickupDayPeriodId], references: [id], onDelete: Restrict)
  // Renomeado de pickupWindow — ver comentário acima.
  pickupTimeNote    String?
  businessHours     String?
  totalWeightKg     Decimal           @db.Decimal(10, 3)
  totalVolumeCount  Int
  totalCubicMeters  Decimal           @db.Decimal(10, 3)
  laborNote         String?
  nfeReference      String?
  romaneioReference String?
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  items             PickupOrderItem[]

  @@index([tenantId, branchId])
  @@index([tenantId, tripId])
}

// Relação de itens da ordem de coleta (D-027) — tabela filha, não campo
// estruturado (jsonb): é lista de tamanho variável, mesmo critério que já
// levou Address a ser entidade própria em vez de blob (D-018). Sem
// branchId: é filho de PickupOrder, que já carrega — mesmo critério de
// CarrierPayment não duplicar o que CarrierHire já modela.
//
// quantity é contagem de volumes do item (caixas, pallets — inteiro).
// weightKg opcional: nem todo item tem peso quebrado por linha, só o
// total do cabeçalho é sempre exigido.
//
// Imutável por inteiro, mesmo critério do pai: corrigir é emitir de novo.
model PickupOrderItem {
  id            String      @id @db.Uuid
  tenantId      String      @db.Uuid
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  pickupOrderId String      @db.Uuid
  pickupOrder   PickupOrder @relation(fields: [pickupOrderId], references: [id])
  description   String
  quantity      Int
  weightKg      Decimal?    @db.Decimal(10, 3)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@index([tenantId, pickupOrderId])
}

// Tipo de documento numerado (D-015) — fixo pelo sistema, não varia por
// tenant, por isso enum e não tabela (D-020, mesmo critério de
// PaymentEventType/UserRole). Só ORDER por ora; CTE/INVOICE entram como
// valor novo de enum quando essas unidades forem construídas — migração
// aditiva (ALTER TYPE ... ADD VALUE), não muda a forma do DocumentCounter.
enum BusinessDocumentType {
  ORDER
  // D-042: fatura ganha numeração de negócio própria, mesmo mecanismo do
  // Order — valor novo de enum, migração aditiva (ALTER TYPE ... ADD
  // VALUE), não muda a forma do DocumentCounter (já antecipado desde
  // D-015/D-035).
  INVOICE
}

// Contador de numeração de negócio (D-015) — nunca SEQUENCE do Postgres:
// sequence consome número em rollback, abre buraco, e buraco de CT-e
// exige inutilização de numeração junto à SEFAZ. Tabela contadora comum,
// incrementada sob SELECT ... FOR UPDATE dentro da MESMA transação que
// grava a entidade numerada (TenantPrisma.transaction + NumberingService,
// não TenantPrisma.db — cada chamada em .db abre a própria mini-transação
// via base.$transaction([...]), o que quebraria o compartilhamento de
// conexão que a atomicidade exige aqui). Um ROLLBACK da transação de
// criação desfaz o incremento junto, porque é UPDATE numa tabela normal,
// não nextval() de SEQUENCE (que nunca é desfeito).
//
// Uma tabela só, reaproveitável por qualquer documento futuro — não uma
// tabela por tipo. Chave pensada pra CT-e desde já, sem precisar de nova
// migração quando ele existir:
// - branchId é CNPJ (D-011) — bate com "sequencial por CNPJ" da D-015
// - documentType distingue o tipo (ORDER e INVOICE hoje, CTE depois)
// - series cobre a série fiscal que CT-e exige ("e por série", D-015);
//   Order não tem série de verdade, sempre usa a constante "1" — NOT NULL
//   com default, não anulável: um "series" anulável quebraria a
//   unicidade (Postgres trata cada NULL como distinto num índice único
//   comum, mesma armadilha que QuoteStatus/DeductionReason já resolveram
//   com índice parcial — aqui nem precisa, porque não é nulo).
//
// lastNumber é o próximo número já emitido (não o próximo a emitir) —
// NumberingService lê com FOR UPDATE, soma 1, grava, e devolve a soma.
model DocumentCounter {
  id           String               @id @db.Uuid
  tenantId     String               @db.Uuid
  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  branchId     String               @db.Uuid
  branch       Branch               @relation(fields: [branchId], references: [id])
  documentType BusinessDocumentType
  series       String               @default("1")
  lastNumber   Int                  @default(0)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, branchId, documentType, series])
}

// Faturamento (D-042, revisa D-025) — validação de campo com o sócio
// contradisse as duas premissas originais: fatura não é mensal (sai logo
// após a entrega, gatilho é o canhoto assinado) e boleto não vem de
// provedor terceiro (sai do banco da própria transportadora). Ver
// docs/decisoes.md D-042 para o raciocínio completo.
//
// Ancora em Order, não em CT-e (que ainda não existe) nem em Trip: Trip
// não carrega nenhum valor (só Order.total, D-014), então ratear entre
// viagens seria inventar contorno pela ausência do CT-e — exatamente o
// que não foi pedido. Order já tem total e customerReference (D-038, o
// eixo — pedido nº 5 da D-042). Quando o CT-e existir, entra como
// referência opcional sem reabrir este desenho.
//
// Sem InvoiceLine/tabela de junção: evidência é 1 Order pertence a no
// máximo 1 Invoice (não N:N) — a FK fica direto em Order.invoiceId, uma
// tabela a menos (CLAUDE.md 2, seção 3.4: arquivo/tabela novo é último
// recurso).
//
// Sem status, sem total: "quanto se deve" deriva de SUM(order.total) dos
// pedidos agrupados; "quanto já foi pago"/"situação" deriva de SUM sobre
// ReceivableEvent (abaixo) — nunca coluna, mesmo critério de
// CarrierPayment/D-032, "do outro lado do caixa".
//
// Sem UPDATE liberado nenhum: nada nesta tabela muda legitimamente
// depois de criada (quais Order pertencem a ela muda pelo lado de
// Order.invoiceId, não daqui). DELETE revogado (D-017: histórico
// financeiro nunca se apaga).
model Invoice {
  id        String   @id @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  // Movimento é da filial (D-011) — mesmo critério de Order/Trip.
  branchId  String   @db.Uuid
  branch    Branch   @relation(fields: [branchId], references: [id])
  // Tomador cobrado — reaproveita Party (D-018), não cadastro próprio.
  partyId   String   @db.Uuid
  party     Party    @relation(fields: [partyId], references: [id])
  // Número de negócio (D-015), mesmo mecanismo de Order.number —
  // DocumentCounter com documentType=INVOICE, atribuído na mesma
  // transação do INSERT.
  number    Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  orders    Order[]
  boletos   Boleto[]
  receivableEvents ReceivableEvent[]

  @@unique([tenantId, branchId, number])
  @@index([tenantId, branchId])
  @@index([tenantId, partyId])
}

// Registro do boleto emitido no banco da transportadora (D-042) — decisão
// revertida da D-025: emitir por provedor (Asaas/Cora/Iugu) trocaria a
// conta em que o dinheiro do cliente cai, objeção comercial que não vale
// arriscar o piloto. Mesmo padrão de D-006/D-019/D-023/D-039: o que mata
// a planilha paralela é o REGISTRO, não a integração — o operador
// continua gerando o boleto no banco, só registra aqui depois.
//
// digitableLine: texto livre, sem CHECK de formato (seção 1.6 — layout
// de linha digitável varia por banco, não é regra estável o bastante pra
// fixar de memória).
//
// 1:N com Invoice, não 1:1 — mesmo critério de TollVoucherPurchase
// (D-036): barato modelar 1:N mesmo achando que é raro mais de um
// boleto por fatura, caro retrofitar 1:1→1:N depois com dado real
// dentro.
//
// PDF anexado via Attachment genérica (ownerType=BOLETO), não campo
// próprio aqui — mesmo mecanismo do canhoto.
//
// Imutável por inteiro: registro simples de algo que já aconteceu no
// banco, sem rascunho. Corrigir é linha nova (D-017), mesmo critério de
// TollVoucherPurchase/PickupOrderItem. UPDATE/DELETE revogados sem
// exceção de coluna.
model Boleto {
  id            String   @id @db.Uuid
  tenantId      String   @db.Uuid
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  invoiceId     String   @db.Uuid
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  number        String
  // Data de calendário, não timestamp (D-016) — vencimento não tem hora.
  dueDate       DateTime @db.Date
  // Escala de valor final (D-013).
  amount        Decimal  @db.Decimal(14, 2)
  digitableLine String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, invoiceId])
}

// Tipo de evento do livro de recebíveis (D-042) — vocabulário fixo do
// sistema, não varia por tenant (D-020, mesmo critério de
// PaymentEventType). Menor que o de CarrierPayment de propósito: sem
// ADVANCE/DEDUCTION — não evidenciados do lado do recebível (a evidência
// fala de conciliar pagamento e cobrar atraso, não de adiantamento nem
// desconto negociado). Não inventar taxonomia que a validação não pediu.
enum ReceivableEventType {
  PAYMENT
  REVERSAL
}

// Livro de eventos append-only do recebível (D-042) — mesmo desenho de
// CarrierPayment (D-032), do outro lado do caixa: nunca coluna de saldo,
// nunca coluna de status. "Quanto falta receber" é SEMPRE
// SUM(order.total) dos pedidos da Invoice MENOS SUM(amount WHERE
// type=PAYMENT) MAIS SUM(amount WHERE type=REVERSAL) — derivado em
// consulta, nunca gravado.
//
// Nasce como livro de eventos mesmo com boleto registrado manualmente
// (não emitido por API ainda) porque, quando a emissão por API entrar
// (D-025 original, fora do escopo agora), ela vira só mais um
// consumidor do MESMO livro — não uma migração de dado financeiro.
//
// amount sempre positivo — sinal/direção vem de type, nunca do número
// (mesmo critério de CarrierPayment/D-012/D-014/D-029: banco garante,
// não confia em disciplina).
//
// reversesReceivableEventId amarra REVERSAL ao evento que desfaz — mesmo
// mecanismo exato de CarrierPayment.reversesPaymentId: CHECK nos dois
// sentidos (só REVERSAL preenche, REVERSAL sempre preenche) e índice
// único parcial impede estornar o mesmo evento duas vezes.
//
// Sem branchId: é filho de Invoice, que já carrega (D-011, mesmo
// critério de CarrierPayment não duplicar o que CarrierHire já modela).
//
// UPDATE e DELETE revogados por inteiro (não GRANT de coluna): nenhuma
// coluna aqui legitimamente muda depois de criada, mesmo critério de
// CarrierPayment.
model ReceivableEvent {
  id        String              @id @db.Uuid
  tenantId  String              @db.Uuid
  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  invoiceId String              @db.Uuid
  invoice   Invoice             @relation(fields: [invoiceId], references: [id])
  type      ReceivableEventType

  amount Decimal @db.Decimal(14, 2)

  reversesReceivableEventId String?           @db.Uuid
  reversesReceivableEvent   ReceivableEvent?  @relation("ReceivableReversal", fields: [reversesReceivableEventId], references: [id])
  reversedBy                ReceivableEvent[] @relation("ReceivableReversal")

  // Data de calendário, não timestamp (D-016) — data do pagamento não
  // tem hora própria relevante ao domínio.
  paymentDate   DateTime @db.Date
  // Texto livre, mesmo critério de CarrierPayment.paymentMethod (seção
  // 1.6 — sem vocabulário estável o bastante pra fixar em enum agora).
  paymentMethod String?
  reference     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, invoiceId])
}

// Entidade dona de um anexo (D-042) — fixo pelo sistema, não varia por
// tenant (D-020, mesmo critério de PaymentEventType): são os tipos de
// TABELA que hoje podem ter anexo, não vocabulário de negócio do tenant.
// Só duas hoje, cada uma com exatamente um AttachmentType correspondente
// — mas "entidade dona" e "tipo" são dimensões propositalmente separadas
// (ver AttachmentType): um TRIP pode um dia ganhar um segundo tipo de
// anexo (ex.: foto de avaria) sem precisar de tabela nova.
enum AttachmentOwnerType {
  TRIP
  BOLETO
}

// Tipo de documento anexado (D-042) — separado de AttachmentOwnerType de
// propósito: a mesma entidade dona pode um dia ter mais de um tipo de
// anexo. Fixo pelo sistema (D-020).
enum AttachmentType {
  // Canhoto assinado — o GATILHO do faturamento (D-042): sem ele, não
  // fatura. Dono é Trip (evento de entrega é por perna, D-018), não
  // Order — Order pode ter mais de uma Trip (transbordo, D-037), cada
  // uma com seu próprio canhoto.
  PROOF_OF_DELIVERY
  // PDF do boleto registrado (Boleto acima). Dono é Boleto.
  BOLETO_PDF
}

// Metadados de anexo (D-042) — decisão nova, nada no sistema fazia isso
// antes. Canhoto não se regenera (diferente do PDF de PickupOrder/D-034,
// gerado sob demanda, nunca gravado, e do XML fiscal, texto pequeno que
// cabe no Postgres) — é uma foto de celular, ~500/mês por transportadora,
// binário grande demais pro banco de aplicação.
//
// Storage: objeto (Cloudflare R2, D-042) — fora do escopo desta unidade
// a integração real (upload/geração de URL assinada): sem bucket/
// credencial pra testar contra algo real, não seria código verificado,
// só inventado (CLAUDE.md 1.4). `objectKey` é só o texto opaco que quem
// subir o arquivo escreve aqui — a tabela não sabe nem precisa saber o
// formato da chave.
//
// ownerType+ownerId é referência POLIMÓRFICA, sem FK — Postgres não tem
// FK que aponte pra "uma linha de uma tabela dentre várias possíveis"
// sem uma tabela extra de referência global (que não existe aqui, e
// criar uma só pra isso seria estrutura que ninguém pediu). Validar que
// ownerId existe de verdade e pertence ao tenant é regra de aplicação
// (D-030), não integridade de concorrência — mesmo critério já aceito em
// PickupOrder.addressId ("nada no banco valida que pertence ao sender").
//
// O RLS continua sendo o guarda (D-012) — sem segunda camada de
// autorização agora, como pedido: a linha de Attachment só é visível
// dentro do próprio tenant, e o acesso ao objeto em si (URL assinada de
// vida curta) só se gera depois de achar a linha aqui — chave nunca
// pública, sempre atrás do backend. Já nasce no formato que a D-010 vai
// precisar quando o embarcador puder baixar o próprio canhoto, mas
// nenhuma tela nem segunda autorização é construída agora.
//
// contentHash: sha256 do arquivo — dedupe e integridade, não validado
// contra o objeto de verdade nesta unidade (sem storage real integrado).
//
// Append-only: UPDATE/DELETE revogados por inteiro — anexo errado é
// linha nova (e, quando a integração real existir, objeto novo no
// storage), nunca edição.
model Attachment {
  id               String              @id @db.Uuid
  tenantId         String              @db.Uuid
  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  ownerType        AttachmentOwnerType
  ownerId          String              @db.Uuid
  type             AttachmentType
  objectKey        String
  contentHash      String
  sizeBytes        Int
  uploadedByUserId String              @db.Uuid
  uploadedByUser   User                @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)

  @@index([tenantId, ownerType, ownerId])
}
